<Window x:Class="Linkora.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Linkora Windows Companion" Width="1120" Height="760" MinWidth="900" MinHeight="620"
        Background="{StaticResource PageBackground}" WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Left"><TextBlock Text="LINKORA" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="Private Android ↔ Windows pairing" Foreground="{StaticResource TextMuted}" FontSize="13"/></StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="Stopped" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,16,0"/><Button x:Name="StartButton" Click="StartButton_Click" Content="Start server" Background="{StaticResource AccentDark}"/><Button x:Name="StopButton" Click="StopButton_Click" Content="Stop" IsEnabled="False"/></StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Padding="16" CornerRadius="10" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Margin="0,0,0,18">
            <DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="Milestone 1 · secure pairing only" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="No cloud, accounts, telemetry or remote control. File transfer and clipboard are intentionally disabled until a later milestone." Foreground="{StaticResource TextMuted}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel><TextBlock DockPanel.Dock="Right" Text="TLS 1.2+  •  LAN only  •  certificate pinned" Foreground="{StaticResource Success}" VerticalAlignment="Center"/></DockPanel>
        </Border>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,18,0"><StackPanel>
                <Border Padding="18" CornerRadius="10" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel>
                    <TextBlock Text="Scan to pair" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Scan this QR code in the Android Linkora app, then compare the six-digit code on both screens." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,16"/>
                    <TextBlock Text="LAN address" Foreground="{StaticResource TextMuted}"/><TextBlock x:Name="HostText" Text="Not running" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,9"/>
                    <TextBlock Text="Port" Foreground="{StaticResource TextMuted}"/><TextBlock Text="43127" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,9"/>
                    <TextBlock Text="Pinned certificate SHA-256" Foreground="{StaticResource TextMuted}"/><TextBlock x:Name="FingerprintText" Text="—" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    <Button x:Name="CopyJsonButton" Click="CopyJsonButton_Click" Content="Copy pairing JSON" Margin="0,18,0,0" IsEnabled="False" HorizontalAlignment="Left"/>
                </StackPanel><Border Grid.Column="1" Background="White" Padding="10" HorizontalAlignment="Right" VerticalAlignment="Top"><Image x:Name="QrImage" Width="190" Height="190"/></Border></Grid></Border>
                <Border Padding="18" CornerRadius="10" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Margin="0,0,0,16"><StackPanel><TextBlock Text="Connected device" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ConnectedText" Text="No trusted Android device connected" Foreground="{StaticResource TextMuted}" Margin="0,7,0,14"/><StackPanel Orientation="Horizontal"><Button x:Name="DisconnectButton" Click="DisconnectButton_Click" Content="Disconnect" IsEnabled="False"/><Button x:Name="RevokeButton" Click="RevokeButton_Click" Content="Revoke trust" IsEnabled="False" Background="#40212A"/></StackPanel></StackPanel></Border>
                <TextBlock Text="Security notes" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,7"/><TextBlock Text="The certificate is self-signed and its DER SHA-256 fingerprint is displayed here. Android pins that fingerprint. A QR token expires after five minutes and is consumed on the first valid request. A new pairing always requires approval on this Windows screen and confirmation on Android." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
            </StackPanel></ScrollViewer>
            <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border x:Name="PendingBorder" Grid.Row="0" Padding="18" CornerRadius="10" Background="#25311F" BorderBrush="{StaticResource Success}" BorderThickness="1" Visibility="Collapsed" Margin="0,0,0,16"><StackPanel><TextBlock Text="Pairing approval required" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="PendingDeviceText" Foreground="{StaticResource TextMuted}" Margin="0,7,0,5"/><TextBlock Text="Verification code" Foreground="{StaticResource TextMuted}"/><TextBlock x:Name="VerificationCodeText" FontFamily="Consolas" FontSize="34" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,3,0,12"/><TextBlock Text="Compare this code with the Android dialog before approving." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,14"/><StackPanel Orientation="Horizontal"><Button Click="ApproveButton_Click" Content="Approve pairing" Background="#21573F"/><Button Click="RejectButton_Click" Content="Reject" Background="#40212A"/></StackPanel></StackPanel></Border>
                <Border Grid.Row="1" Padding="18" CornerRadius="10" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Diagnostic log" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBox x:Name="LogText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#0A111D" Foreground="{StaticResource TextMuted}" BorderBrush="{StaticResource PanelBorder}" FontFamily="Consolas" FontSize="12" Padding="10"/></DockPanel></Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
